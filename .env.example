# Optional: enables subscribed AlienVault OTX pulses.
OTX_API_KEY=

# Optional: increases GitHub Advisory API rate limits.
GITHUB_TOKEN=

# Optional: comma-separated Vercel frontend origin(s) for cross-origin API calls.
FRONTEND_ORIGINS=

# Upstream request deadline in seconds.
HTTP_TIMEOUT_SECONDS=12

# Local SQLite history retention and API response bound.
THREAT_RETENTION_DAYS=90
MAX_API_RECORDS=250

# Optional: override the SQLite path (Render Free storage is ephemeral).
DATABASE_PATH=data/vanguardintel.db
